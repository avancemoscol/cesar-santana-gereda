---
const site = (Astro.site!.href.replace(/\/$/, '') + import.meta.env.BASE_URL).replace(/\/$/, '');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = 'César Andrés Santana Gereda | Ingeniero Mecánico y Desarrollador Web';
const description =
  'César Andrés Santana Gereda: ingeniero mecánico y desarrollador web en Bucaramanga, Colombia. Automatización de procesos empresariales con software e IA, análisis de datos con Python y aplicaciones web.';
const image = `${site}/cesar.jpg`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site}/#person`,
      name: 'César Andrés Santana Gereda',
      alternateName: ['César Santana', 'Andrés Santana', 'César Andres Santana Gereda'],
      givenName: 'César Andrés',
      familyName: 'Santana Gereda',
      jobTitle: 'Ingeniero Mecánico y Desarrollador Web',
      description,
      url: `${site}/`,
      image,
      email: 'mailto:casgereda.1@gmail.com',
      address: { '@type': 'PostalAddress', addressLocality: 'Bucaramanga', addressRegion: 'Santander', addressCountry: 'CO' },
      alumniOf: [
        { '@type': 'CollegeOrUniversity', name: 'Universidad Industrial de Santander' },
        { '@type': 'CollegeOrUniversity', name: 'Universidad del Norte' },
      ],
      knowsAbout: ['Ingeniería mecánica', 'SolidWorks', 'ANSYS', 'Python', 'Análisis de datos', 'Machine Learning', 'React', 'Node.js', 'Flutter', 'Docencia'],
      knowsLanguage: ['es', 'en'],
      sameAs: [
        'https://www.linkedin.com/in/césar-andres-santana-gereda-01381b122',
        'https://github.com/andressantage',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      url: `${site}/`,
      name: 'César Andrés Santana Gereda',
      inLanguage: 'es',
      publisher: { '@id': `${site}/#person` },
    },
    {
      '@type': 'ProfilePage',
      url: `${site}/`,
      mainEntity: { '@id': `${site}/#person` },
    },
  ],
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="César Andrés Santana Gereda" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#0b1020" />
    <link rel="canonical" href={`${site}/`} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="César Andrés Santana Gereda" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${site}/`} />
    <meta property="og:image" content={image} />
    <meta property="profile:first_name" content="César Andrés" />
    <meta property="profile:last_name" content="Santana Gereda" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
